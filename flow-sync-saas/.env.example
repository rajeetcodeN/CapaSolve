# ==============================================================================
# CapaSolve / FlowSync SaaS — Production Environment Configuration Template
# ==============================================================================

# Supabase Server-Side Configuration (Used by Nitro / Serverless Functions)
SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-private-key
SUPABASE_BUCKET_NAME=scheduler

# Supabase Client-Side Configuration (Exposed to browser via Vite)
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Mistral AI Engine (Server-Side Only - Keep secure, do NOT prefix with VITE_)
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# Application Runtime Configuration
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://app.capasolve.com,http://localhost:3000
